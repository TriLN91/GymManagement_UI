# Copy to .env.local and adjust. Never commit real secrets.
VITE_APP_NAME=AI Fitness Coaching
VITE_DEFAULT_LOCALE=en
# Backend: http://localhost:5167/api (launchSettings) ; mock API (MSW) ignores this value
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_API_TIMEOUT_MS=15000
# "true" / "false". Default: on in dev, off in production builds.
VITE_ENABLE_MSW=true
VITE_OAUTH_GOOGLE_CLIENT_ID=
VITE_OAUTH_APPLE_CLIENT_ID=
